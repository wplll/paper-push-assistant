# === DeepSeek API ===
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# === SMTP 邮件 ===
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# === 推送配置 ===
PAPERS_PER_DAY=5
MIN_PAPERS_PER_DAY=3
SKIP_EMPTY_EMAIL=true
REQUEST_TIMEOUT=30

# === 论文来源 ===
README_RAW_URL=https://raw.githubusercontent.com/983632847/Awesome-Multimodal-Object-Tracking/main/README.md

# === 存储 ===
SENT_HISTORY_PATH=data/sent_history.json
